{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public client member profile without sensitive PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "points": {
          "type": "number"
        },
        "tier": {
          "type": "string",
          "enum": ["bronze", "silver", "gold", "platinum"]
        },
        "referralCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "points", "tier", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-only PII record storing client email, phone, and organization details",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "defaultAddress": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "SoftwareOrder": {
      "title": "SoftwareOrder",
      "description": "Persisted web app order placed with Daaga Software Builders including payment verification details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^DSB-[0-9]{4}-[0-9]{4}$"
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "clientPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "companyName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "projectTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "packageId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "packageTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "addonsSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "timelineWindow": {
          "type": "string",
          "enum": ["urgent_2_3_weeks", "standard_4_6_weeks", "flexible_8_plus_weeks"]
        },
        "engagementModel": {
          "type": "string",
          "enum": ["fixed_scope", "milestone_retainer"]
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD"]
        },
        "estimatedTotal": {
          "type": "number"
        },
        "paymentPreference": {
          "type": "string",
          "enum": ["milestone_upi_bank", "corporate_invoice", "card_checkout"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "unpaid"]
        },
        "paidAmount": {
          "type": "number"
        },
        "paymentRef": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "projectBrief": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2500
        },
        "referenceUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "kickoffSlot": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["received", "scoping", "in_development", "qa_staging", "delivered"]
        },
        "studioNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "orderNumber",
        "clientName",
        "clientEmail",
        "clientPhone",
        "companyName",
        "projectTitle",
        "packageId",
        "packageTitle",
        "addonsSummary",
        "timelineWindow",
        "engagementModel",
        "currency",
        "estimatedTotal",
        "paymentPreference",
        "projectBrief",
        "referenceUrl",
        "kickoffSlot",
        "status",
        "studioNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "Legacy order archive record linked to an authenticated customer UID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 3, "maxLength": 32 },
        "tokenNumber": { "type": "number" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fulfillmentType": { "type": "string", "enum": ["pickup", "delivery"] },
        "pickupLocation": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "enum": ["received", "in_hearth", "cooling", "ready_for_pickup", "completed"] },
        "paymentMethod": { "type": "string", "enum": ["upi", "card", "cash"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending_cash"] },
        "total": { "type": "number" },
        "itemsSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "orderNumber", "tokenNumber", "customerName",
        "fulfillmentType", "pickupLocation", "status", "paymentMethod",
        "paymentStatus", "total", "itemsSummary", "createdAt", "updatedAt"
      ]
    },
    "SavedCreation": {
      "title": "SavedCreation",
      "description": "Saved artifact metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "creationType": { "type": "string", "enum": ["cake-3d", "ai-image", "ai-video", "ai-music"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "creatorName", "title", "creationType", "prompt", "isPublic", "createdAt"]
    },
    "SharedInvite": {
      "title": "SharedInvite",
      "description": "Shareable referral invite record",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bonusPoints": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "ownerUid", "ownerName", "bonusPoints", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public profile record for authenticated clients."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII subcollection containing client email, phone, and organization."
    },
    "/projectOrders/{orderId}": {
      "schema": { "$ref": "#/entities/SoftwareOrder" },
      "description": "Web app orders placed with Daaga Software Builders including payment verification status, paid amount, and UTR reference."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Legacy order collection preserved for backward compatibility."
    },
    "/creations/{creationId}": {
      "schema": { "$ref": "#/entities/SavedCreation" },
      "description": "Legacy saved creations collection preserved for backward compatibility."
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/SharedInvite" },
      "description": "Shareable invite codes collection."
    }
  }
}
