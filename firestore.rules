rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot-time connection check document only
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'yashpillalamarri2013@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'points', 'tier', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'points', 'tier', 'referralCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.points is number && data.points >= 0 && data.points <= 1000000
        && data.tier in ['bronze', 'silver', 'gold', 'platinum']
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'defaultAddress', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('defaultAddress' in data) || (data.defaultAddress is string && data.defaultAddress.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSoftwareOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'orderNumber', 'clientName', 'clientEmail', 'clientPhone',
          'companyName', 'projectTitle', 'packageId', 'packageTitle', 'addonsSummary',
          'timelineWindow', 'engagementModel', 'currency', 'estimatedTotal',
          'paymentPreference', 'projectBrief', 'referenceUrl', 'kickoffSlot',
          'status', 'studioNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'orderNumber', 'clientName', 'clientEmail', 'clientPhone',
          'companyName', 'projectTitle', 'packageId', 'packageTitle', 'addonsSummary',
          'timelineWindow', 'engagementModel', 'currency', 'estimatedTotal',
          'paymentPreference', 'paymentStatus', 'paidAmount', 'paymentRef',
          'projectBrief', 'referenceUrl', 'kickoffSlot',
          'status', 'studioNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
        && data.orderNumber.matches('^DSB-[0-9]{4}-[0-9]{4}$')
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100
        && data.clientEmail is string && data.clientEmail.size() >= 3 && data.clientEmail.size() <= 200
        && data.clientPhone is string && data.clientPhone.size() <= 30
        && data.companyName is string && data.companyName.size() <= 120
        && data.projectTitle is string && data.projectTitle.size() >= 2 && data.projectTitle.size() <= 160
        && data.packageId is string && data.packageId.size() >= 2 && data.packageId.size() <= 80
        && data.packageTitle is string && data.packageTitle.size() >= 2 && data.packageTitle.size() <= 160
        && data.addonsSummary is string && data.addonsSummary.size() <= 600
        && data.timelineWindow in ['urgent_2_3_weeks', 'standard_4_6_weeks', 'flexible_8_plus_weeks']
        && data.engagementModel in ['fixed_scope', 'milestone_retainer']
        && data.currency in ['INR', 'USD']
        && data.estimatedTotal is number && data.estimatedTotal >= 0 && data.estimatedTotal <= 50000000
        && data.paymentPreference in ['milestone_upi_bank', 'corporate_invoice', 'card_checkout']
        && (!('paymentStatus' in data) || data.paymentStatus in ['paid', 'unpaid'])
        && (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 50000000))
        && (!('paymentRef' in data) || (data.paymentRef is string && data.paymentRef.size() <= 100))
        && data.projectBrief is string && data.projectBrief.size() >= 10 && data.projectBrief.size() <= 2500
        && data.referenceUrl is string && data.referenceUrl.size() <= 300
        && data.kickoffSlot is string && data.kickoffSlot.size() >= 2 && data.kickoffSlot.size() <= 100
        && data.status in ['received', 'scoping', 'in_development', 'qa_staging', 'delivered']
        && data.studioNote is string && data.studioNote.size() <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentOnCreate(data) {
      return ('paymentStatus' in data)
        && ('paidAmount' in data)
        && ('paymentRef' in data)
        && (
          (data.paymentStatus == 'unpaid' && data.paidAmount == 0) ||
          (
            data.paymentStatus == 'paid'
            && data.paidAmount == data.estimatedTotal
            && data.paidAmount > 0
            && data.paymentRef.size() >= 3
          )
        );
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'orderNumber', 'tokenNumber', 'customerName',
          'fulfillmentType', 'pickupLocation', 'status', 'paymentMethod',
          'paymentStatus', 'total', 'itemsSummary', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'orderNumber', 'tokenNumber', 'customerName',
          'fulfillmentType', 'pickupLocation', 'status', 'paymentMethod',
          'paymentStatus', 'total', 'itemsSummary', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32
        && data.tokenNumber is number && data.tokenNumber >= 1 && data.tokenNumber <= 1000000
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.fulfillmentType in ['pickup', 'delivery']
        && data.pickupLocation is string && data.pickupLocation.size() >= 1 && data.pickupLocation.size() <= 160
        && data.status in ['received', 'in_hearth', 'cooling', 'ready_for_pickup', 'completed']
        && data.paymentMethod in ['upi', 'card', 'cash']
        && data.paymentStatus in ['paid', 'pending_cash']
        && data.total is number && data.total >= 0 && data.total <= 500000
        && data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCreation(data) {
      return data.keys().hasAll(['id', 'userId', 'creatorName', 'title', 'creationType', 'prompt', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'creatorName', 'title', 'creationType', 'prompt', 'isPublic', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.creationType in ['cake-3d', 'ai-image', 'ai-video', 'ai-music']
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 1000
        && data.isPublic is bool
        && data.createdAt is timestamp;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['code', 'ownerUid', 'ownerName', 'bonusPoints', 'createdAt'])
        && data.keys().hasOnly(['code', 'ownerUid', 'ownerName', 'bonusPoints', 'createdAt'])
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 40 && data.code.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidId(data.ownerUid)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100
        && data.bonusPoints is number && data.bonusPoints >= 0 && data.bonusPoints <= 1000
        && data.createdAt is timestamp;
    }

    // Admin registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminUid);
    }

    // Public member profile (no PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().points <= 500
        && incoming().tier == 'bronze'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'points', 'tier', 'referralCode', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Private PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin();
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'defaultAddress', 'updatedAt'])
            )
          );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    // Web App Build Orders (Daaga Software Builders + Paid Orders Portal)
    match /projectOrders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidSoftwareOrder(incoming())
        && isValidPaymentOnCreate(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'received'
        && incoming().studioNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidSoftwareOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && existing().status != 'delivered'
            && incoming().diff(existing()).affectedKeys().hasOnly(['projectBrief', 'referenceUrl', 'kickoffSlot', 'updatedAt'])
          ) ||
          (
            existing().userId == request.auth.uid
            && existing().status != 'delivered'
            && (!('paymentStatus' in existing()) || existing().paymentStatus == 'unpaid')
            && incoming().paymentStatus == 'paid'
            && incoming().paidAmount == existing().estimatedTotal
            && incoming().paidAmount > 0
            && incoming().paymentRef.size() >= 3
            && incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paidAmount', 'paymentRef', 'paymentPreference', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Legacy orders collection (preserved)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'received'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && existing().status != 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['pickupLocation', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Legacy creations collection (preserved)
    match /creations/{creationId} {
      allow get: if isValidId(creationId) && isSignedIn() && (existing().userId == request.auth.uid || existing().isPublic == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(creationId)
        && isValidCreation(incoming())
        && incoming().id == creationId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(creationId)
        && isValidCreation(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'isPublic'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(creationId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Legacy invites collection (preserved)
    match /invites/{inviteId} {
      allow get: if isValidId(inviteId) && isSignedIn();
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidInvite(incoming())
        && incoming().code == inviteId
        && incoming().ownerUid == request.auth.uid
        && incoming().bonusPoints == 100
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(inviteId);
    }
  }
}
